# TaskManager の環境変数の例（docs/environment/configuration.md）
# 1. このファイルを .env にコピーする:  cp .env.example .env
# 2. 空欄の Secret をすべて新しく生成して設定する（下の生成コマンドを参照）
# 3. .env は Git に登録しない（.gitignore 済み）
#
# パスワードは接続文字列に埋め込むため、; ' " を含まない値にすること。
#   生成例: openssl rand -hex 24
# JWT 署名鍵は Base64 で 32 バイト以上:
#   生成例: openssl rand -base64 48

# --- Web ---
TM_WEB_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
TM_DB_NAME=taskmanager_db
TM_DB_APP_USER=taskmanager_app
TM_DB_APP_PASSWORD=
TM_DB_MIGRATOR_USER=taskmanager_migrator
TM_DB_MIGRATOR_PASSWORD=

# --- API ---
TM_ASPNETCORE_ENVIRONMENT=Production
TM_JWT_SIGNING_KEY=
TM_JWT_ISSUER=taskmanager
TM_JWT_AUDIENCE=taskmanager-web
# Swagger UI と /openapi/v1.json の公開（本番は false）
TM_ENABLE_SWAGGER=false
# リフレッシュ Cookie の Secure 属性。HTTPS で公開する場合は true のまま。
# http://localhost 以外の HTTP（LAN 内の検証など）で動かす場合のみ false にする
TM_COOKIE_SECURE=true
# 初期システム管理者（システム管理者が 1 人もいないときだけ作成。初回ログイン時にパスワード変更が必要）
# パスワードは 12 文字以上。作成後はこの 2 行を空にしてよい
TM_BOOTSTRAP_ADMIN_EMAIL=
TM_BOOTSTRAP_ADMIN_PASSWORD=

# --- 開発用（docker-compose.dev.yml） ---
TM_DB_PORT=3307
TM_API_PORT=5080
